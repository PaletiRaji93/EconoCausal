  "dag": {
    "assumptions": [
      {
        "name": "Randomised treatment",
        "kind": "design assumption",
        "text": "'treatment' was assigned at random, so no covariate affects assignment (no covariate->treatment edges). Verify with balance checks."
      },
      {
        "name": "Overlap / positivity",
        "kind": "identification assumption",
        "text": "Every covariate profile has a non-zero chance of being treated and untreated. Checked empirically by propensity-score overlap diagnostics."
      },
      {
        "name": "Consistency / SUTVA",
        "kind": "identification assumption",
        "text": "A unit's observed outcome equals its potential outcome under the treatment received, and one customer's treatment does not affect another's outcome (no interference)."
      },
      {
        "name": "Pretreatment covariates only",
        "kind": "design choice",
        "text": "Covariates are measured before treatment. Post-treatment variables (e.g. exposure, revenue) are excluded because adjusting for them can introduce bias."
      },
      {
        "name": "Correlation vs causation",
        "kind": "caveat",
        "text": "The DAG is an assumed structure. Association in data does not prove these arrows."
      },
      {
        "name": "Possible unobserved confounder (U_unmeasured)",
        "kind": "threat to validity",
        "text": "Drawn as a dashed node to remind readers that unmeasured causes of both treatment and outcome would bias estimates; refutation tests cannot rule this out."
      }
    ],
